      "chapter_id": "periodic-classification-of-elements",
      "question_text": "Two elements, A and B belong to the 3rd period of Modern Periodic Table.\nElement A belongs to Group 1 whereas Element B belongs to Group 16.\nCompare the following characteristics of A and B, giving justification for\neach :\n(a) Atomic size\n(b) Metallic character",
      "marks": 2,
      "type": "short",
      "options": null,
      "correct_option": null,
      "has_diagram": false,
      "source": [
        {
          "folder": "Science 7",
          "file": "31-1-3 Science.pdf",
          "session": "2022 Term-2 main (May 2022)",
          "series": "QQARR/1",
          "set_code": "31/1/3",
          "question_no": 1
        }
      ],
      "exam_pattern": "2022_term2",
      "marking_points": [
        {
          "point": "(a) • Atomic size of A is greater than atomic size of B",
          "marks": 0.5
