# Copy this file to .streamlit/secrets.toml (gitignored) and fill in real values.
# On Streamlit Community Cloud, paste the same content into your app's
# Settings -> Secrets instead of committing a file.

GOOGLE_API_KEY = "your-google-generative-ai-api-key-here"

# Optional: only needed if you want chat history to persist across visits.
# Without this section the app still works, but chats are session-only.
SUPABASE_URL = "https://your-project.supabase.co"
SUPABASE_SERVICE_KEY = "your-supabase-service-role-key"

# Optional: only needed together with the Supabase settings above, to identify
# which student a saved chat belongs to via Google sign-in.
[auth]
redirect_uri = "http://localhost:8501/oauth2callback"
cookie_secret = "generate-with-python -c \"import secrets; print(secrets.token_hex(32))\""
client_id = "your-google-oauth-client-id"
client_secret = "your-google-oauth-client-secret"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
